// Writes a random APP_SECRET to .env.local for local development, so the
// application never runs with a secret that is published in the repository.

$envLocalFile = dirname(__DIR__).'/.env.local';

$readEnv = static function (string $name): string {
    $value = $_SERVER[$name] ?? $_ENV[$name] ?? getenv($name);

    return \is_string($value) ? trim($value) : '';
};

if ('' !== $readEnv('APP_SECRET')) {
    exit(0);
}

$appEnv = $readEnv('APP_ENV');
if ('' !== $appEnv && !\in_array($appEnv, ['dev', 'test'], true)) {
    fwrite(\STDERR, sprintf("APP_ENV is \"%s\": not generating APP_SECRET. Define it in a real environment variable or in the secrets vault.\n", $appEnv));
    exit(0);
}

$envLocal = is_file($envLocalFile) ? (string) file_get_contents($envLocalFile) : '';
if (1 === preg_match('/^\s*(export\s+)?APP_SECRET\s*=\s*[\'"]?[^\s\'"#]/m', $envLocal)) {
    exit(0);
}

$separator = '' === $envLocal || str_ends_with($envLocal, "\n") ? '' : "\n";
file_put_contents($envLocalFile, $separator.'APP_SECRET='.bin2hex(random_bytes(32))."\n", \FILE_APPEND | \LOCK_EX);

echo "Generated a random APP_SECRET in .env.local\n";
